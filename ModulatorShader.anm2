--[[
  Modulator (AviUtl2 Modern Port)
  Original Author: Aodaruma
  
  C++ DLLで行われていたピクセルごとの輝度累積処理を
  HLSLのピクセルシェーダーでGPU処理するように完全移植しました。
  
  AviUtl2の乗算済みアルファおよび16bit Floatカラー空間に対応しています。
]]

--label:Modulator Shader
--track@scale_val:ｽｹｰﾙ,0.5,100.0,5.0,0.1
--track@drawing_val:描画数,1,100,10,1
--track@interval_val:間隔数,0,100,2,1
--track@width_val:幅(px),1,10,2,1
--check@invert_flag:反転,false
--select@direction:方向=0,左から右=0,上から下=1,右から左=2,下から上=3
--track@threshold_val:閾値,0,256,255,1
--track@opaMax_val:透明度(白),0,256,256,1
--track@opaMin_val:透明度(黒),0,256,256,1

--[[pixelshader@modulator_ps:
    // 【修正点】Luaから渡される配列はすべてfloatになるため、
    // バッファの受け皿はすべてfloat型にする必要があります。
    cbuffer params : register(b0) {
        float omega;
        float phase;
        float dist;
        float dist2;
        
        float line_width;
        float invert;
        float direction;
        float opaMax;
        
        float opaMin;
        float width_px;
        float height_px;
        float padding;
    };
    Texture2D tex : register(t0);
    SamplerState samp : register(s0);

    float4 modulator_ps(float4 pos : SV_Position, float2 uv : TEXCOORD0) : SV_Target {
        // floatで受け取った変数を安全にintへキャスト
        int _dist = int(dist);
        int _dist2 = int(dist2);
        int _line_width = int(line_width);
        int _invert = int(invert);
        int _direction = int(direction);

        // UV座標のスケール差異（0.0~1.0 または 0~w）を自動判別して正規化
        float2 norm_uv = uv;
        if (width_px > 1.0 && uv.x > 1.5) {
            norm_uv.x = uv.x / width_px;
            norm_uv.y = uv.y / height_px;
        }

        // 実際のピクセル座標(整数)を安全に計算
        int px = clamp(int(norm_uv.x * width_px), 0, int(width_px) - 1);
        int py = clamp(int(norm_uv.y * height_px), 0, int(height_px) - 1);
        
        int2 current_pos;
        int2 step_dir;
        int max_steps;
        
        // 描画方向に応じた走査の開始点と進行方向ベクトルを決定
        if (_direction == 0) {
            current_pos = int2(0, py);
            step_dir = int2(1, 0);
            max_steps = px;
        } else if (_direction == 1) {
            current_pos = int2(px, 0);
            step_dir = int2(0, 1);
            max_steps = py;
        } else if (_direction == 2) {
            current_pos = int2(int(width_px) - 1, py);
            step_dir = int2(-1, 0);
            max_steps = int(width_px) - 1 - px;
        } else {
            current_pos = int2(px, int(height_px) - 1);
            step_dir = int2(0, -1);
            max_steps = int(height_px) - 1 - py;
        }
        
        int drawpx = 0;
        int drawing_c = 0;
        int interval_c = 0;
        float lumisum = 0.0;
        
        // GPU上で該当ピクセルに到達するまでの状態変化をシミュレートする
        [loop]
        for (int i = 0; i <= max_steps; i++) {
            int2 sample_pos = current_pos + step_dir * i;
            
            // 整数座標でテクスチャの色をフェッチ
            float4 col = tex.Load(int3(sample_pos, 0));
            
            // AviUtl2の乗算済みアルファを解除し、元のRGBを復元
            float3 rgb = col.rgb;
            if (col.a > 0.0001) {
                rgb /= col.a;
            }
            
            // 元のC++ロジックに合わせて0〜255スケールに変換
            float r = rgb.r * 255.0;
            float g = rgb.g * 255.0;
            float b = rgb.b * 255.0;
            
            float lumi = 0.298912 * r + 0.586611 * g + 0.114478 * b;
            if (_invert != 0) {
                lumi = 255.0 - lumi;
            }
            // オリジナルのロジックに従い輝度をクランプ
            lumi = max(1.0, min(256.0, lumi));
            
            lumisum += omega * lumi;
            
            // 輝度の累積値が閾値を超えたら状態遷移
            if (lumisum >= phase) {
                lumisum = 0.0;
                if (interval_c == 0 && drawing_c == 0) {
                    drawing_c = _dist;
                    interval_c = _dist2;
                } else if (interval_c == 0 && drawing_c > 0) {
                    drawpx = _line_width;
                    drawing_c--;
                } else {
                    interval_c--;
                }
            }
            
            // 目的のピクセル（現在の位置）に到達した場合、結果を出力して終了
            if (i == max_steps) {
                if (drawpx > 0) {
                    // 白線: Premultiplied Alpha
                    return float4(opaMax, opaMax, opaMax, opaMax);
                } else {
                    // 黒線: Premultiplied Alpha (RGBは黒なので0.0)
                    return float4(0.0, 0.0, 0.0, opaMin);
                }
            }
            
            // ピクセル幅のカウントを消費
            if (drawpx > 0) {
                drawpx--;
            }
        }
        
        // フォールバック
        return float4(0.0, 0.0, 0.0, 0.0);
    }
]]

-- Lua側でのパラメータ準備と正規化
local omega = (scale_val / 100.0) * 2.5
local phase = threshold_val
local dist = math.floor(drawing_val)
local dist2 = math.floor(interval_val)
local line_width = math.floor(width_val)
local inv = invert_flag and 1.0 or 0.0
local dir = direction * 1.0

-- AviUtl2の透明度は0.0～1.0ベースなので変換
local aMax = opaMax_val / 256.0
local aMin = opaMin_val / 256.0

local w = obj.w
local h = obj.h

-- 定数バッファ(cbuffer)に渡す配列を作成
-- ★全て自動的にfloatとして扱われGPUに転送されます
local constants = {
    omega, phase, dist, dist2,
    line_width, inv, dir, aMax,
    aMin, w, h, 0.0
}

-- ピクセルシェーダーの実行 (自分自身のテクスチャを入力とし、自分自身を書き換える)
obj.pixelshader("modulator_ps", "object", {"object"}, constants)